{
  "name": "@moonshot-ai/kimi-desktop-tauri",
  "version": "0.1.0-internal.0",
  "private": true,
  "license": "MIT",
  "description": "Partial Lunar Eclipse desktop client (Tauri) — a Svelte 5 shell around the Kimi server.",
