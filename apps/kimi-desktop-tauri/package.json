    "@tauri-apps/plugin-os": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.0",
    "marked": "18.0.5",
    "shiki": "^4.3.0",
    "svelte-i18n": "^4.0.0"
